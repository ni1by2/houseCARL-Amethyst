<Project Sdk="Microsoft.NET.Sdk">

  <!-- Linux-only, self-contained release installer. It keeps mutable user configuration outside the
       versioned server tree and performs server upgrades through same-filesystem directory renames. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HousecarlSetup</RootNamespace>
    <AssemblyName>housecarl-amethyst-install</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
